{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FireflyChan",
  "version": "1.0.0",
  "identifier": "com.fireflychan.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*", "$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Q-Ghast",
    "copyright": "Copyright © 2026 Q-Ghast",
    "shortDescription": "流萤桌面 AI 截图助手",
    "longDescription": "FireflyChan 是一个以流萤为主题的 Windows 桌面 AI 截图助手，支持截图问答、快捷提示词、联网搜索和可拖动桌宠。",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
